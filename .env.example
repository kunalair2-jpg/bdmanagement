NODE_ENV=development
# Local development uses SQLite by default.
DATABASE_URL=file:./dev.db
# Fill these only when you connect to Turso in Vercel or production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Default country code used by phone parsing.
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91
SESSION_COOKIE_NAME=bd_session
SESSION_MAX_AGE_DAYS=30